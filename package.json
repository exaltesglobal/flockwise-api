{
  "name": "flockwise-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "description": "Flockwise backend API: email sign-in, people, events, check-in, volunteers, service planning, groups, giving with Razorpay, messaging and care.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "hono": "^4.13.13",
    "mysql2": "^3.24.6",
    "nodemailer": "^6.10.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
