# ---- Server ----
PORT=3000
# Public URL of this API (used for Razorpay return links), and the web app (allowed for CORS, return target).
API_PUBLIC_URL=https://api.flockwise.church
WEB_URL=https://app.flockwise.church
# Signs access tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# ---- Church (single church until multi-tenant onboarding ships) ----
CHURCH_ID=ch_1
CHURCH_NAME=Grace Community Church
CHURCH_COUNTRY=IN
CHURCH_CURRENCY=INR

# ---- Database (Hostinger MySQL). Leave DB_HOST empty to use an in-memory store for local testing. ----
# From a Node app on Hostinger use 127.0.0.1, not the srvNNNN.hstgr.io host.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- Razorpay (Dashboard > Account & Settings > API keys; use Test Mode keys first) ----
# Leave RAZORPAY_KEY_ID empty to use the built-in fake checkout page for testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks: URL https://api.flockwise.church/v1/webhooks/razorpay
# Events: payment_link.paid, payment_link.expired, payment_link.cancelled, subscription.activated, subscription.charged, subscription.halted, subscription.cancelled, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Optional: a second Razorpay account settled to the church's FCRA account (SBI New Delhi Main Branch).
# Gifts from foreign citizens / OCI holders go here. If empty, those gifts are refused.
RAZORPAY_FCRA_KEY_ID=
RAZORPAY_FCRA_KEY_SECRET=
RAZORPAY_FCRA_WEBHOOK_SECRET=

# ---- Development only ----
# true = accept requests without a token, as the demo member (never in production).
DEV_AUTH=false
