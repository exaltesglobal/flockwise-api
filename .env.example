# Flockwise API settings. On Hostinger set these under Websites > your Node.js app > Environment variables.
# Never commit a real .env file. Full setup guide: docs/ENVIRONMENT.md

# ---- Server ----
NODE_ENV=production
PORT=3000
API_PUBLIC_URL=https://api.flockwise.church
WEB_URL=https://app.flockwise.church
# Extra allowed web origins, comma separated (e.g. a staging site)
CORS_ORIGINS=
# Long random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- Church (one church per deployment for now) ----
CHURCH_ID=ch_1
CHURCH_NAME=Grace Community Church
CHURCH_CITY=Hyderabad
CHURCH_COUNTRY=IN
CHURCH_CURRENCY=INR
# First church office login, created on first start. Sign in at /admin with this email.
OWNER_EMAIL=
OWNER_NAME=

# ---- Database (Hostinger MySQL). Use 127.0.0.1 from the app, not the srvNNNN.hstgr.io host. ----
# The API creates its one table (`records`) on first start.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Local development without MySQL: keep data in a JSON file instead (leave DB_HOST empty)
DATA_FILE=
# Fill an empty database with the sample church (testing only, refused in production)
SEED_DEMO=false

# ---- Email (required in production: sign-in codes are sent by email) ----
EMAIL_FROM=Grace Community Church <hello@flockwise.church>
# Option A: Hostinger email SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Option B: Resend
RESEND_API_KEY=

# ---- SMS for church messages (optional; not used for sign-in) ----
# msg91 or twilio
SMS_PROVIDER=
MSG91_AUTH_KEY=
# DLT-approved template with one variable
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- WhatsApp Cloud API for church messages (optional; not used for sign-in) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# approved template with one body variable
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ---- Razorpay (Account & Settings > API keys; start with Test Mode keys) ----
# Empty = built-in test checkout page so the flow can be tried without an account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://api.flockwise.church/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Optional second account settled to the church's FCRA account (gifts from foreign citizens / OCI)
RAZORPAY_FCRA_KEY_ID=
RAZORPAY_FCRA_KEY_SECRET=
RAZORPAY_FCRA_WEBHOOK_SECRET=
